WEIGHT_QUANTITY=0.25
WEIGHT_URGENCY=0.15
WEIGHT_LOCATION=0.10
WEIGHT_EXPIRY=0.10

# ─── Recommendation defaults ─────────────────────────────────────────────────
# Maximum number of recommendations returned per request (can be overridden per-call)
DEFAULT_LIMIT=5

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Node.js backend URL)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# ─── MongoDB (for /from-db endpoints) ────────────────────────────────────────
# Paste your MongoDB connection string here (same one used in the Node.js backend)
MONGODB_URL=mongodb://localhost:27017
DB_NAME=medical_supply

# Collection names (must match what your Node.js backend uses)
INVENTORY_COLLECTION=inventories
SHORTAGE_COLLECTION=shortages
FACILITY_COLLECTION=facilities


